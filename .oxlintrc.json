{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      // Dependency direction: app -> shell -> modules -> shared. Mocks are dev-only (like app).
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["#modules/**", "#app/**", "#shell/**", "**/modules/**", "**/app/**", "**/shell/**"],
            "message": "shared is the lowest layer: it must not import modules, shell or app." }
        ] }]
      }
    },
    {
      "files": ["src/shell/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["#modules/**", "#app/**", "**/modules/**", "**/app/**"],
            "message": "shell receives modules from app/ and never imports them." }
        ] }]
      }
    },
    {
      // A module reaches other code only via shared. Own files use relative imports.
      "files": ["src/modules/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["#modules/**", "#app/**", "#shell/**", "**/modules/**", "**/app/**", "**/shell/**"],
            "message": "A module may import only #shared and its own files (never another module, shell or app)." }
        ] }]
      }
    },
    {
      "files": ["src/app/**", "src/mocks/**", "src/main.tsx"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["#modules/*/**", "!#modules/*/index.ts"],
            "message": "Import a module only through its public entry: #modules/<name>/index.ts." }
        ] }]
      }
    },
    {
      "files": ["src/**/*.test.ts"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
